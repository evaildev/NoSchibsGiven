{
  "manifest_version": 3,
  "name": "NoSchibsGiven",
  "version": "3.0.1",
  "description": "Blokkerer Schibsted sin betalte samtykke-popup og all client-side sporing på Schibsted Media-sider.",
  "permissions": [
    "declarativeNetRequest",
    "scripting",
    "storage",
    "activeTab",
    "webRequest"
  ],
  "host_permissions": [
    "*://*.aftenbladet.no/*",
    "*://*.aftenposten.no/*",
    "*://*.aftonbladet.se/*",
    "*://*.ap.no/*",
    "*://*.bt.no/*",
    "*://*.confirmit.com/*",
