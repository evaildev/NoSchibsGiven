    "*://*.e24.no/*",
    "*://*.fvn.no/*",
    "*://*.godt.no/*",
    "*://*.omni.se/*",
    "*://*.privacy-mgmt.com/*",
    "*://*.side2.no/*",
    "*://*.sourcepoint.com/*",
    "*://*.svd.se/*",
    "*://*.tek.no/*",
    "*://*.vg.no/*",
    "*://*.vgd.no/*",
    "*://ads.inventory.schibsted.io/*",
    "*://ads.inventory.schibsted.no/*",
    "*://ads.skm.microsoft.com/*",
    "*://adsdkprod.azureedge.net/*",
    "*://aftenbladet.no/*",
    "*://aftenposten.no/*",
    "*://aftonbladet.se/*",
    "*://ap.no/*",
    "*://assets.vg.no/*",
    "*://bt.no/*",
    "*://cdn.privacy-mgmt.com/*",
    "*://cis.schibsted.com/*",
    "*://cmp.aftenbladet.no/*",
    "*://cmp.aftenposten.no/*",
    "*://cmp.aftonbladet.se/*",
    "*://cmp.ap.no/*",
    "*://cmp.bt.no/*",
    "*://cmp.e24.no/*",
    "*://cmp.fvn.no/*",
    "*://cmp.godt.no/*",
    "*://cmp.omni.se/*",
    "*://cmp.side2.no/*",
    "*://cmp.svd.se/*",
    "*://cmp.tek.no/*",
    "*://cmp.vg.no/*",
    "*://cmp.vgd.no/*",
    "*://cognifront.mvt.forbruker.schibsted.no/*",
    "*://collector.schibsted.io/*",
    "*://dc.schibsted.io/*",
    "*://e24.no/*",
    "*://esv.schibsted.com/*",
    "*://fbevents-a.akamaihd.net/*",
    "*://fvn.no/*",
    "*://godt.no/*",
    "*://log.insider.no/*",
    "*://log.medietall.no/*",
    "*://ncis.schibsted.com/*",
    "*://omni.se/*",
    "*://pulse.schibsted.media/*",
    "*://sdk.pulse.schibsted.com/*",
    "*://sdkconfig.pulse.schibsted.io/*",
    "*://sentry.vgnett.no/*",
    "*://session-admin.payment.schibsted.no/*",
    "*://session-service.payment.schibsted.no/*",
    "*://side2.no/*",
    "*://static.privacy.schibsted.com/*",
    "*://svd.se/*",
    "*://tag.medialab.no/*",
    "*://tek.no/*",
    "*://vend.schibsted.ai/*",
    "*://vg.no/*",
    "*://vgd.no/*",
    "*://www.aftenbladet.no/*",
    "*://www.aftenposten.no/*",
    "*://www.aftonbladet.se/*",
    "*://www.ap.no/*",
    "*://www.bt.no/*",
    "*://www.e24.no/*",
    "*://www.fvn.no/*",
    "*://www.godt.no/*",
    "*://www.omni.se/*",
    "*://www.side2.no/*",
    "*://www.svd.se/*",
    "*://www.tek.no/*",
    "*://www.vg.no/*",
    "*://www.vgd.no/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.aftenbladet.no/*",
        "*://*.aftenposten.no/*",
        "*://*.aftonbladet.se/*",
        "*://*.ap.no/*",
        "*://*.bt.no/*",
        "*://*.e24.no/*",
        "*://*.fvn.no/*",
        "*://*.godt.no/*",
        "*://*.omni.se/*",
        "*://*.side2.no/*",
        "*://*.svd.se/*",
        "*://*.tek.no/*",
        "*://*.vg.no/*",
        "*://*.vgd.no/*",
        "*://*/*",
        "*://aftenbladet.no/*",
        "*://aftenposten.no/*",
        "*://aftonbladet.se/*",
        "*://ap.no/*",
        "*://bt.no/*",
        "*://e24.no/*",
        "*://fvn.no/*",
        "*://godt.no/*",
        "*://omni.se/*",
        "*://side2.no/*",
        "*://svd.se/*",
        "*://tek.no/*",
        "*://vg.no/*",
        "*://vgd.no/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": {
    "scripts": [
      "sites.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "NoSchibsGiven",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "noschibsgiven@evaildev",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
