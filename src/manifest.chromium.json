{
  "manifest_version": 3,
  "name": "NoSchibsGiven",
  "version": "2.1",
  "description": "Blokkerer Schibsted sin betalte samtykke-popup og all client-side sporing på Schibsted Media-sider.",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.privacy-mgmt.com/*",
    "*://*.sourcepoint.com/*",
    "*://cmp.tek.no/*",
    "*://cmp.vg.no/*",
    "*://cmp.bt.no/*",
    "*://cmp.ba.no/*",
    "*://cmp.e24.no/*",
    "*://cmp.aftenposten.no/*",
    "*://cmp.aftonbladet.se/*",
    "*://cmp.omni.se/*",
    "*://cmp.hbl.fi/*",
    "*://sdk.pulse.schibsted.com/*",
    "*://static.privacy.schibsted.com/*",
    "*://ads.inventory.schibsted.io/*",
    "*://log.mediafall.no/*",
    "*://*.datadoghq-browser-agent.com/*",
    "*://*.adnxs-simple.com/*",
    "*://adsdkprod.azureedge.net/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
