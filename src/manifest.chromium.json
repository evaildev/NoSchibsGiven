{
  "manifest_version": 3,
  "name": "Schibsted Cookie Popup Blocker",
  "version": "2.0",
  "description": "Blocks Schibsted/SourcePoint cookie consent popups. Works on all SourcePoint-based sites.",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.privacy-mgmt.com/*",
    "*://*.sourcepoint.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [{
      "id": "ruleset_1",
      "enabled": true,
      "path": "rules.json"
    }]
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
